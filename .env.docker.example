# Шаблон для Droplet: /var/www/trading2d/.env
# cp .env.docker.example .env && nano .env
# НЕ комітити .env

DJANGO_SETTINGS_MODULE=config.settings.docker
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM
DEBUG=False
ADMIN_URL=manage

POSTGRES_DB=trading2d
POSTGRES_USER=trading2d
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432

# HTTP (до certbot). Після SSL — блок нижче.
ALLOWED_HOSTS=trading2d.com,www.trading2d.com,207.154.249.50,127.0.0.1,localhost,web
CSRF_TRUSTED_ORIGINS=http://207.154.249.50,http://trading2d.com,http://www.trading2d.com
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_SSL_REDIRECT=False

SITE_DOMAIN=trading2d.com
SITE_PROTOCOL=http

# --- Після certbot (замінити HTTP-блок вище) ---
# SITE_PROTOCOL=https
# CSRF_TRUSTED_ORIGINS=https://trading2d.com,https://www.trading2d.com
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

GUNICORN_WORKERS=2

NOVA_POSHTA_API_KEY=
NOVA_POSHTA_API_URL=https://api.novaposhta.ua/v2.0/json/

LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=True

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@trading2d.com
