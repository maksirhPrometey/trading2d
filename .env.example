# Скопіюйте цей файл у .env і заповніть реальними значеннями.
# Ніколи не комітьте .env у git.

SECRET_KEY=change-me-generate-a-new-random-secret-key
DEBUG=False
ALLOWED_HOSTS=trading2d.com,www.trading2d.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://trading2d.com,https://www.trading2d.com

# Адмінка (config.settings.base.ADMIN_URL) — змініть з дефолтного /admin/
ADMIN_URL=admin/

# PostgreSQL (тільки config.settings.prod)
DB_NAME=trading2d
DB_USER=trading2d
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Nova Poshta API (Фаза 5.3)
NOVA_POSHTA_API_KEY=
NOVA_POSHTA_API_URL=https://api.novaposhta.ua/v2.0/json/

# LiqPay (Фаза 5.4)
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=True

SITE_DOMAIN=trading2d.com
SITE_PROTOCOL=https

# Docker / Droplet: копіюйте .env.docker.example → .env на сервері.

# SMTP (тільки config.settings.prod)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
